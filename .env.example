# ──────────────────────────────────────────────
# Global
# ──────────────────────────────────────────────
COMPOSE_PROJECT_NAME=thinkslides
NODE_ENV=development

# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=thinkslides
POSTGRES_USER=thinkslides
POSTGRES_PASSWORD=thinkslides_dev_password
DATABASE_URL=postgresql+asyncpg://thinkslides:thinkslides_dev_password@postgres:5432/thinkslides?ssl=disable
# For Go orchestrator (pgx)
ORCHESTRATOR_DATABASE_URL=postgresql://thinkslides:thinkslides_dev_password@postgres:5432/thinkslides

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ──────────────────────────────────────────────
# JWT Authentication
# ──────────────────────────────────────────────
JWT_SECRET=thinkslides-dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=72

# ──────────────────────────────────────────────
# LLM Provider
# Options: zhipu, azure_openai
# ──────────────────────────────────────────────
LLM_PROVIDER=zhipu

# Zhipu GLM
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_MODEL=glm-4.7

# ──────────────────────────────────────────────
# Web Search Backend (used by the web_search agent tool)
# Options: zhipu, tavily
# zhipu (default) is China-focused; tavily returns Western/international
# sources for better factual grounding on non-Chinese content.
# ──────────────────────────────────────────────
WEB_SEARCH_PROVIDER=zhipu
# Required when WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Tavily search depth: basic | advanced
TAVILY_SEARCH_DEPTH=advanced

# Azure OpenAI (used when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ──────────────────────────────────────────────
# Vision LLM (for PDF/image-based template analysis)
# Uses the same provider as LLM_PROVIDER by default
# ──────────────────────────────────────────────
VISION_LLM_PROVIDER=zhipu
ZHIPU_VISION_MODEL=glm-4.6v
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o

# ──────────────────────────────────────────────
# Service Ports
# ──────────────────────────────────────────────
WEB_PORT=3000
AI_SERVICE_PORT=8000
ORCHESTRATOR_PORT=8080
NEXT_PUBLIC_ORCHESTRATOR_PORT=8080
PORT=8080

# ──────────────────────────────────────────────
# Frontend (Next.js)
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_AI_URL=
NEXT_PUBLIC_DEV_MODE=false

# ──────────────────────────────────────────────
# Service URLs
# ──────────────────────────────────────────────
AI_SERVICE_URL=http://ai-service:8000
ORCHESTRATOR_URL=http://orchestrator:8080
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:8080

# ──────────────────────────────────────────────
# Storage
# ──────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
TEMPLATE_DIR=/app/templates
OUTPUT_DIR=/app/output
MAX_UPLOAD_SIZE_MB=50

# ──────────────────────────────────────────────
# Observability
# ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json


# ──────────────────────────────────────────────
# Orchestrator (Go)
# ──────────────────────────────────────────────
DEV_MODE=false
