# ──────────────────────────────────────────────
# Global
# ──────────────────────────────────────────────
COMPOSE_PROJECT_NAME=slideagent
NODE_ENV=development

# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=slideagent
POSTGRES_USER=slideagent
POSTGRES_PASSWORD=slideagent_dev_password
DATABASE_URL=postgresql+asyncpg://slideagent:slideagent_dev_password@postgres:5432/slideagent

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ──────────────────────────────────────────────
# JWT Authentication
# ──────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=72

# ──────────────────────────────────────────────
# LLM Provider
# Options: zhipu, azure_openai
# ──────────────────────────────────────────────
LLM_PROVIDER=zhipu

# Zhipu GLM
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_MODEL=glm-4

# Azure OpenAI (used when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ──────────────────────────────────────────────
# Service Ports
# ──────────────────────────────────────────────
WEB_PORT=3000
AI_SERVICE_PORT=8000
ORCHESTRATOR_PORT=8080

# ──────────────────────────────────────────────
# Storage
# ──────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
TEMPLATE_DIR=/app/templates
OUTPUT_DIR=/app/output
MAX_UPLOAD_SIZE_MB=50

# ──────────────────────────────────────────────
# Observability
# ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json